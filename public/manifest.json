{
  "manifest_version": 3,
  "name": "Haunted DevTools",
  "version": "0.1.0",
  "description": "Local-first debugging guidance for browser errors.",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": ["http://127.0.0.1:11434/*", "http://localhost:11434/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-errors-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["error-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
